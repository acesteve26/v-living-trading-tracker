# Copy this file to ".env" for local development, or set these as environment
# variables in your hosting provider (Render: Dashboard > Environment).
#
# NEVER commit the real .env file — it is excluded in .gitignore.

# Signs login cookies. Required in production; generated automatically for local dev.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Only used the very first time the app starts against an empty database,
# to create the administrator account. If you leave ADMIN_PASSWORD blank, a random
# password is generated and printed to the log once.
ADMIN_EMAIL=admin@vliving.local
ADMIN_PASSWORD=

# Set to "production" when hosting. Enables secure cookies and refuses to start
# without a SESSION_SECRET.
NODE_ENV=

# The port to listen on. Render sets this automatically — leave blank locally.
PORT=
